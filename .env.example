NODE_ENV=development
APP_NAME=JSAMS
APP_PORT=3000
API_PREFIX=/api
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:5173
ORACLE_CLIENT_MODE=thick
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=host:1521/service-name
ORACLE_CLIENT_LIB_DIR=C:/path/to/oracle/instantclient
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT_SECONDS=60
ORACLE_QUEUE_TIMEOUT_MS=10000
ORACLE_STATEMENT_CACHE_SIZE=50
ORACLE_CONNECTION_TIMEOUT_MS=10000
ORACLE_ENABLE_EVENTS=false
RUN_ORACLE_INTEGRATION_TESTS=false
PHASE1_SMOKE_USER=
AUTH_MODE=development
# DIRECT_BIND validates the submitted identity directly. SERVICE_SEARCH additionally requires bind credentials.
LDAP_AUTH_STRATEGY=DIRECT_BIND
LDAP_HOST=
LDAP_PORT=389
# Required only for SERVICE_SEARCH and directory-dependent administrative scripts.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
LDAP_USERNAME_ATTRIBUTE=sAMAccountName
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
LDAP_IDENTITY_ATTRIBUTE=objectGUID
LDAP_UPN_SUFFIX=pvdrilling.com.vn
LDAP_NETBIOS_DOMAIN=PVDRILLING
# LDAPS | STARTTLS | NONE. NONE is rejected in production.
LDAP_TLS_MODE=STARTTLS
# Development/UAT compatibility only for a legacy DC certificate; rejected in production.
LDAP_TLS_LEGACY_COMPATIBILITY=false
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_OPERATION_TIMEOUT_MS=10000
# Temporary migration aid when SYS_USER still uses username as ENTERPRISE_IDENTITY_KEY.
LDAP_ALLOW_USERNAME_FALLBACK=false
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_MINUTES=480
AUTH_SESSION_COOKIE_NAME=jsams_session
AUTH_SESSION_COOKIE_SECURE=false
# One-time/idempotent LDAP administrator seed. Defaults to phuclh when omitted.
SEED_LDAP_ADMIN_USERNAME=phuclh
LOCAL_SITE_CODE=DEV
LOCAL_SITE_ID=
# Fail-closed Phase 3 boundaries. Populate only with approved permission codes and numbering policy.
JSA_PERMISSION_VIEW=
JSA_PERMISSION_CREATE=
JSA_PERMISSION_EDIT=
JSA_PERMISSION_CANCEL=
# Configure all Phase 4 action mappings together. Values are governed permission codes, not defaults.
JSA_PERMISSION_SUBMIT=DEV_JSA_SUBMIT
JSA_PERMISSION_APPROVE=DEV_JSA_APPROVE
JSA_PERMISSION_RETURN=DEV_JSA_RETURN
JSA_PERMISSION_REJECT=DEV_JSA_REJECT
JSA_PERMISSION_COMMENT=DEV_JSA_COMMENT
JSA_PERMISSION_WORKFLOW_VIEW=DEV_JSA_WORKFLOW_VIEW
JSA_PERMISSION_WORKFLOW_ADMIN=DEV_JSA_WORKFLOW_ADMIN
SEED_UAT_APPROVER_USERNAME=phuclh
# Temporary Draft/approval identifier only. Official numbers are assigned at publication.
JSA_NUMBER_TEMPLATE=
JSA_NUMBER_UNIQUENESS_SCOPE=

# Attachment binaries remain outside Oracle. Use the same relative tree at every
# site; a third-party file synchronizer is responsible for cross-site binary sync.
ATTACHMENT_STORAGE_ROOT=D:\JSAMS\attachments
ATTACHMENT_MAX_FILE_SIZE_BYTES=52428800
BOOTSTRAP_SITE_CODE=
BOOTSTRAP_SITE_NAME=
BOOTSTRAP_SITE_TIMEZONE=Asia/Ho_Chi_Minh
BOOTSTRAP_SEQUENCE_RANGE_START=
BOOTSTRAP_SEQUENCE_RANGE_END=
BOOTSTRAP_ADMIN_IDENTITY_KEY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_EMAIL=
PHASE2_BOOTSTRAP_ACTOR=
PHASE4_BOOTSTRAP_ACTOR=
PHASE45_BOOTSTRAP_ACTOR=
LOG_LEVEL=info
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_AUTH_MODE=development
VITE_DEV_USER=admin
