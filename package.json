{
  "name": "jsams",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @jsams/api --filter @jsams/web dev",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "corepack pnpm -r test",
    "build": "corepack pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:status": "corepack pnpm --dir database run status",
    "db:up": "corepack pnpm --dir database run up",
    "db:down": "corepack pnpm --dir database run down",
    "db:verify": "corepack pnpm --dir database run verify",
    "db:verify:phase1": "corepack pnpm --dir database run verify:phase1",
    "db:verify:phase2": "corepack pnpm --dir database run verify:phase2",
    "db:verify:phase3": "corepack pnpm --dir database run verify:phase3",
    "db:verify:phase4": "corepack pnpm --dir database run verify:phase4",
    "db:verify:phase45": "corepack pnpm --dir database run verify:phase45",
    "db:verify:phase5": "corepack pnpm --dir database run verify:phase5",
    "db:verify:phase6": "corepack pnpm --dir database run verify:phase6",
    "db:verify:phase6c": "corepack pnpm --dir database run verify:phase6c",
    "db:verify:phase7": "corepack pnpm --dir database run verify:phase7",
    "db:verify:legacy-risk-matrix": "corepack pnpm --dir database run verify:legacy-risk-matrix",
    "db:verify:pv-drilling-3x3-risk-matrix": "corepack pnpm --dir database run verify:pv-drilling-3x3-risk-matrix",
    "db:verify:pv-drilling-sites-rigs": "corepack pnpm --dir database run verify:pv-drilling-sites-rigs",
    "db:verify:development-jsa-reset-and-rig-matrices": "corepack pnpm --dir database run verify:development-jsa-reset-and-rig-matrices",
    "db:verify:pv-drilling-departments": "corepack pnpm --dir database run verify:pv-drilling-departments",
    "db:verify:legacy-hazard-prompts": "corepack pnpm --dir database run verify:legacy-hazard-prompts",
    "db:verify:pv-drilling-positions": "corepack pnpm --dir database run verify:pv-drilling-positions",
    "db:verify:pv-drilling-tools": "corepack pnpm --dir database run verify:pv-drilling-tools",
    "db:verify:translation-languages": "corepack pnpm --dir database run verify:translation-languages",
    "db:verify:uat-full-approval": "corepack pnpm --dir database run verify:uat-full-approval",
    "db:verify:uat-translation-access": "corepack pnpm --dir database run verify:uat-translation-access",
    "db:bootstrap:phase1": "corepack pnpm --dir database run bootstrap:phase1",
    "db:bootstrap:phase2": "corepack pnpm --dir database run bootstrap:phase2",
    "db:bootstrap:phase3": "corepack pnpm --dir database run bootstrap:phase3",
    "db:bootstrap:phase4": "corepack pnpm --dir database run bootstrap:phase4",
    "db:bootstrap:phase45": "corepack pnpm --dir database run bootstrap:phase45",
    "db:bootstrap:phase6": "corepack pnpm --dir database run bootstrap:phase6",
    "db:bootstrap:phase6c": "corepack pnpm --dir database run bootstrap:phase6c",
    "db:bootstrap:phase7": "corepack pnpm --dir database run bootstrap:phase7",
    "db:bootstrap:attachments": "corepack pnpm --dir database run bootstrap:attachments",
    "db:cleanup:own-test-jsas": "corepack pnpm --dir database run cleanup:own-test-jsas",
    "db:reset:development-jsas-and-rig-matrices": "corepack pnpm --dir database run reset:development-jsas-and-rig-matrices",
    "db:seed:ldap-admin": "corepack pnpm --dir database run seed:ldap-admin",
    "db:seed:legacy-risk-matrix": "corepack pnpm --dir database run seed:legacy-risk-matrix",
    "db:seed:pv-drilling-3x3-risk-matrix": "corepack pnpm --dir database run seed:pv-drilling-3x3-risk-matrix",
    "db:seed:pv-drilling-sites-rigs": "corepack pnpm --dir database run seed:pv-drilling-sites-rigs",
    "db:seed:pv-drilling-departments": "corepack pnpm --dir database run seed:pv-drilling-departments",
    "db:seed:legacy-hazard-prompts": "corepack pnpm --dir database run seed:legacy-hazard-prompts",
    "db:seed:pv-drilling-positions": "corepack pnpm --dir database run seed:pv-drilling-positions",
    "db:seed:pv-drilling-tools": "corepack pnpm --dir database run seed:pv-drilling-tools",
    "db:seed:translation-languages": "corepack pnpm --dir database run seed:translation-languages",
    "db:seed:uat-full-approval": "corepack pnpm --dir database run seed:uat-full-approval",
    "db:seed:uat-translation-access": "corepack pnpm --dir database run seed:uat-translation-access",
    "oracle:diagnose": "corepack pnpm --filter @jsams/api oracle:diagnose",
    "oracle:test": "corepack pnpm --filter @jsams/api oracle:test",
    "oracle:readiness": "corepack pnpm --filter @jsams/api oracle:readiness",
    "oracle:api-smoke": "corepack pnpm --filter @jsams/api oracle:api-smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
